        // 加载节点类型总数
        async function loadNodeTypeCounts() {
            try {
                const response = await fetch(`${API_BASE_URL}/graph/node-counts`);
                const data = await response.json();
                
                if (data.success) {
                    displayNodeTypeCounts(data.counts);
                    console.log('节点类型总数:', data.counts);
                }
            } catch (error) {
                console.error('加载节点类型总数失败:', error);
            }
        }

        // 显示节点类型总数
function displayNodeTypeCounts(counts) {
    const container = document.getElementById('node-type-counts');
    container.innerHTML = '';

    if (counts) {
        // 为容器添加滚动条样式和美化
        container.style.maxHeight = '200px';
        container.style.overflowY = 'auto';
        container.style.backgroundColor = '#FFFFFF';
        container.style.borderRadius = '8px';
        container.style.border = '1px solid #B0C4DE';
        container.style.padding = '4px 0';

        // 自定义滚动条样式（Webkit浏览器）
        container.style.scrollbarWidth = 'thin';
        container.style.scrollbarColor = '#87CEFA #F0F8FF';

        const entries = Object.entries(counts);
        entries.forEach(([type, count], index) => {
            const item = document.createElement('div');
            // 根据奇偶行添加不同的背景色
            const bgColor = index % 2 === 0 ? '#FFFFFF' : '#F0F8FF';
            item.className = 'flex justify-between items-center';
            item.style.padding = '8px 12px';
            item.style.margin = '0';
            item.style.backgroundColor = bgColor;
            item.style.transition = 'all 0.2s ease';

            // 添加悬停效果
            item.onmouseenter = () => {
                item.style.backgroundColor = '#E0FFFF';
                item.style.transform = 'translateX(2px)';
            };
            item.onmouseleave = () => {
                item.style.backgroundColor = bgColor;
                item.style.transform = 'translateX(0)';
            };

            item.innerHTML = `
                <span class="text-gray-700" style="font-size: 13px; font-weight: 500;">${this.escapeHtml ? this.escapeHtml(type) : type}:</span>
                <span style="font-weight: 600; color: #1E90FF; background: #F0F8FF; padding: 2px 8px; border-radius: 12px; font-size: 13px;">${count}</span>
            `;
            container.appendChild(item);
        });

        // 添加自定义滚动条样式（通过style标签）
        if (!document.getElementById('custom-scrollbar-style')) {
            const style = document.createElement('style');
            style.id = 'custom-scrollbar-style';
            style.textContent = `
                #node-type-counts::-webkit-scrollbar {
                    width: 6px;
                    height: 6px;
                }
                #node-type-counts::-webkit-scrollbar-track {
                    background: #F0F8FF;
                    border-radius: 3px;
                }
                #node-type-counts::-webkit-scrollbar-thumb {
                    background: #87CEFA;
                    border-radius: 3px;
                }
                #node-type-counts::-webkit-scrollbar-thumb:hover {
                    background: #6495ED;
                }
            `;
            document.head.appendChild(style);
        }
    } else {
        // 空状态显示
        const emptyMsg = document.createElement('div');
        emptyMsg.className = 'text-center';
        emptyMsg.style.padding = '20px';
        emptyMsg.style.color = '#B0C4DE';
        emptyMsg.style.fontSize = '14px';
        emptyMsg.innerText = '暂无数据';
        container.appendChild(emptyMsg);
    }
}
        
        // 导入对话
        async function importConversation() {
            const fileInput = document.getElementById('import-file');
            const titleInput = document.getElementById('import-title');
            const file = fileInput.files[0];
            const title = titleInput.value.trim();
            
            if (!file) {
                alert('请选择要导入的对话文件');
                return;
            }
            
            if (!title) {
                alert('请输入对话标题');
                return;
            }
            
            const formData = new FormData();
            formData.append('file', file);
            formData.append('title', title);
            
            try {
                const response = await fetch(`${API_BASE_URL}/import`, {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                if (data.success) {
                    alert('对话导入成功');
                    loadConversations();
                    updateConversationCount();
                    showChatContent();
                    selectConversation(data.conversation_id);
                } else {
                    alert('导入失败: ' + data.message);
                }
            } catch (error) {
                console.error('导入对话失败:', error);
                alert('导入失败: ' + (error.message || '未知错误'));
            }
        }
        
        // 显示全部知识图谱
        async function showAllGraph() {
            console.log('显示全部知识图谱');
            const nodeLimit = document.getElementById('node-limit').value;
            executeGraphQuery('', nodeLimit);
            // 显示加载更多按钮
            document.getElementById('load-more').classList.remove('hidden');
        }
        
        async function loadMoreGraph() {
            console.log('加载更多节点');
            alert('加载更多功能正在开发中，请使用关键词查询特定节点');
        }
        
        // 执行图谱查询
        async function executeGraphQuery(query = '', nodeLimit = null) {
            const entityType = document.getElementById('entity-type').value;
            
            // 如果没有传入nodeLimit，使用滑块的值
            if (nodeLimit === null) {
                nodeLimit = document.getElementById('node-limit').value;
            }
            
            console.log('执行图谱查询:', { query, entityType, nodeLimit });
            
            try {
                const response = await fetch(`${API_BASE_URL}/graph/query`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        query: query,
                        entity_type: entityType,
                        node_limit: parseInt(nodeLimit)
                    })
                });
                
                console.log('图谱查询响应状态:', response.status);
                
                const data = await response.json();
                console.log('图谱查询响应数据:', data);
                
                if (data.success) {
                    console.log('渲染图谱:', { nodes: data.nodes.length, edges: data.edges.length });
                    renderGraph(data.nodes, data.edges);
                    updateGraphStats(data.stats);
                } else {
                    console.error('查询失败:', data.message);
                    alert('查询失败: ' + (data.message || '未知错误'));
                }
            } catch (error) {
                console.error('执行图谱查询失败:', error);
                alert('查询失败: ' + (error.message || '未知错误'));
            }
        }
        
        // 渲染知识图谱
        function renderGraph(nodes, edges) {
            const container = document.getElementById('graph-container');
            
            // 清空容器
            container.innerHTML = '';
            
            // 准备数据
            const visNodes = nodes.map(node => ({
                id: node.id,
                label: node.label && node.label.length > 15 ? node.label.substring(0, 15) + '...' : (node.label || node.id),
                title: `${node.label} (${node.type})`,
                group: node.type,
                color: {
                    background: getNodeColor(node.type),
                    border: getNodeColor(node.type),
                    highlight: {
                        background: '#ffffff',
                        border: getNodeColor(node.type)
                    },
                    hover: {
                        background: '#f3f4f6',
                        border: getNodeColor(node.type)
                    }
                },
                shape: getNodeShape(node.type),
                size: node.type === 'Equipment' ? 25 : (node.type === 'Component' ? 20 : 15)
            }));
            
            const visEdges = edges.map(edge => ({
                from: edge.from_id || edge.from,
                to: edge.to_id || edge.to,
                label: edge.label,
                title: edge.label
            }));
            
            const data = {
                nodes: visNodes,
                edges: visEdges
            };
            
            const options = {
                nodes: {
                    shape: 'dot',
                    size: 20,
                    font: {
                        size: 12,
                        face: 'Arial',
                        color: '#333333',
                        strokeWidth: 2,
                        strokeColor: '#ffffff'
                    },
                    borderWidth: 1,
                    shadow: {
                        enabled: false
                    }
                },
                edges: {
                    width: 1,
                    color: {
                        color: '#848484',
                        highlight: '#3b82f6',
                        hover: '#3b82f6'
                    },
                    font: {
                        size: 10,
                        face: 'Arial',
                        color: '#666666',
                        background: '#ffffff',
                        strokeWidth: 2,
                        strokeColor: '#ffffff'
                    },
                    smooth: {
                        type: 'continuous',
                        roundness: 0.5
                    },
                    arrows: {
                        to: {
                            enabled: true,
                            scaleFactor: 0.3
                        }
                    }
                },
                layout: {
                    improvedLayout: true
                },
                interaction: {
                    zoomView: true,
                    dragView: true,
                    hover: true,
                    tooltipDelay: 200
                },
                physics: {
                    enabled: true,
                    barnesHut: {
                        gravitationalConstant: -3000,
                        centralGravity: 0.3,
                        springLength: 95,
                        springConstant: 0.04,
                        damping: 0.09,
                        avoidOverlap: 0.2
                    },
                    stabilization: {
                        enabled: true,
                        iterations: 1000,
                        updateInterval: 50,
                        onlyDynamicEdges: false,
                        fit: true
                    }
                }
            };
            
            // 创建网络
            currentGraph = new vis.Network(container, data, options);
            
            // 添加事件监听
            currentGraph.on('click', function(params) {
                if (params.nodes.length > 0) {
                    const nodeId = params.nodes[0];
                    const node = nodes.find(n => n.id === nodeId);
                    if (node) {
                        console.log('点击节点:', node);
                    }
                }
            });
            
            currentGraph.on('stabilizationIterationsDone', function() {
                console.log('图谱稳定完成');
            });
        }
        
        // 获取节点颜色
        function getNodeColor(type) {
            const colorMap = {
                'Equipment': '#3b82f6',      // 蓝色
                'Component': '#10b981',      // 绿色
                'Fault': '#ef4444',          // 红色
                'FaultReason': '#f59e0b',    // 橙色
                'MaintenanceAction': '#8b5cf6', // 紫色
                'SafetyNotice': '#ec4899',   // 粉色
                'KnowledgeSource': '#6b7280', // 灰色
                'Category': '#14b8a6',       // 青色
                'FaultPhenomenon': '#f97316', // 橙红色
                'FaultCause': '#eab308',     // 黄色
                'RepairAction': '#a855f7',   // 深紫色
                'Notice': '#f43f5e',         // 玫瑰红
                'Unknown': '#9ca3af'         // 浅灰色
            };
            return colorMap[type] || '#9ca3af';
        }
        
        // 获取节点形状
        function getNodeShape(type) {
            const shapeMap = {
                'Equipment': 'box',
                'Component': 'dot',
                'Fault': 'diamond',
                'FaultReason': 'triangle',
                'MaintenanceAction': 'star',
                'SafetyNotice': 'hexagon',
                'KnowledgeSource': 'square'
            };
            return shapeMap[type] || 'dot';
        }
        
        // 更新图谱统计信息
        function updateGraphStats(stats) {
            const statsContainer = document.getElementById('graph-stats');
            statsContainer.innerHTML = '';
            
            if (stats) {
                // 显示基本统计信息
                Object.entries(stats).forEach(([key, value]) => {
                    if (key !== 'entity_types') {
                        const statItem = document.createElement('div');
                        statItem.textContent = `${key}: ${value}`;
                        statsContainer.appendChild(statItem);
                    }
                });
                
                // 创建节点类型分布饼图
                if (stats.entity_types) {
                    createNodeTypeChart(stats.entity_types);
                }
            }
        }
        
        // 创建节点类型分布饼图
        function createNodeTypeChart(entityTypes) {
            const ctx = document.getElementById('nodeTypeChart').getContext('2d');
            
            // 准备数据
            const labels = [];
            const data = [];
            const backgroundColors = [
                '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6',
                '#ec4899', '#06b6d4', '#14b8a6', '#84cc16', '#f97316'
            ];
            
            Object.entries(entityTypes).forEach(([type, count], index) => {
                if (count > 0) {
                    labels.push(type);
                    data.push(count);
                }
            });
            
            // 销毁旧图表
            if (window.nodeTypeChart) {
                window.nodeTypeChart.destroy();
            }
            
            // 创建新图表
            window.nodeTypeChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: backgroundColors.slice(0, data.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    size: 12
                                },
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }
        
        // 设置事件监听器
        function setupEventListeners() {
            // 消息表单提交
            document.getElementById('message-form').addEventListener('submit', function(e) {
                e.preventDefault();
                sendMessage();
            });
            
            // 导航按钮
            document.getElementById('nav-chat').addEventListener('click', function() {
                showChatContent();
                // 更新导航按钮状态
                updateNavButtons('chat');
            });
            
            document.getElementById('nav-visualize').addEventListener('click', function() {
                showVisualizeContent();
                updateNavButtons('visualize');
            });
            
            document.getElementById('nav-import').addEventListener('click', function() {
                showImportContent();
                updateNavButtons('import');
            });
            
            document.getElementById('nav-material').addEventListener('click', function() {
                showMaterialContent();
                updateNavButtons('material');
            });
            
            document.getElementById('nav-operationsData').addEventListener('click', function() {
                showOperationsDataContent();
                updateNavButtons('operationsData');
            });
            
            // 新对话按钮
            document.getElementById('new-conversation-btn').addEventListener('click', function() {
                document.getElementById('new-conversation-modal').classList.remove('hidden');
            });
            
            // 取消创建对话
            document.getElementById('cancel-new-conversation').addEventListener('click', function() {
                document.getElementById('new-conversation-modal').classList.add('hidden');
                document.getElementById('conversation-title-input').value = '';
            });
            
            // 确认创建对话
            document.getElementById('confirm-new-conversation').addEventListener('click', createNewConversation);
            
            // 导出对话
            document.getElementById('export-conversation').addEventListener('click', exportConversation);
            
            // 导出 Word
            document.getElementById('export-word').addEventListener('click', function(e) {
                e.stopPropagation();
                exportConversationToWord();
            });
            
            // 导出 JSON
            document.getElementById('export-json').addEventListener('click', function(e) {
                e.stopPropagation();
                exportConversation();
            });

            // 导出 MD
            document.getElementById('export-md').addEventListener('click', function(e) {
                e.stopPropagation();
                exportConversationToMD();
            });
            
            // 删除对话
            document.getElementById('delete-conversation').addEventListener('click', deleteConversation);
            
            // 点击模态框外部关闭
            document.getElementById('new-conversation-modal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.add('hidden');
                    document.getElementById('conversation-title-input').value = '';
                }
            });
            
            // 导入对话
            document.getElementById('confirm-import').addEventListener('click', importConversation);
            document.getElementById('cancel-import').addEventListener('click', showChatContent);
            
            // 导入资料
            // 预览按钮点击事件
            document.getElementById('preview-material').addEventListener('click', previewMaterial);
            
            // 导入按钮点击事件 - 先触发预览
            document.getElementById('confirm-material').addEventListener('click', function() {
                // 先执行预览，然后在预览结果中提供确认选项
                previewMaterial();
            });
            
            document.getElementById('cancel-material').addEventListener('click', showChatContent);
            
            // 图谱查询
            document.getElementById('execute-query').addEventListener('click', function() {
                const query = document.getElementById('graph-query').value.trim();
                executeGraphQuery(query);
            });
            
            // 显示全部知识图谱
            document.getElementById('show-all').addEventListener('click', showAllGraph);
            
            // 加载更多
            document.getElementById('load-more').addEventListener('click', loadMoreGraph);
            
            // 节点数量限制滑块
            const nodeLimitSlider = document.getElementById('node-limit');
            const nodeLimitValue = document.getElementById('node-limit-value');
            nodeLimitSlider.addEventListener('input', function() {
                nodeLimitValue.textContent = this.value;
                // 如果超过300，显示警告
                if (parseInt(this.value) > 300) {
                    nodeLimitValue.classList.add('text-orange-500');
                } else {
                    nodeLimitValue.classList.remove('text-orange-500');
                }
            });
            
            // 刷新节点类型总数
            document.getElementById('refresh-counts').addEventListener('click', loadNodeTypeCounts);
        }
        
        // 更新导航按钮状态
        function updateNavButtons(activeNav) {
            const navButtons = ['chat', 'visualize', 'import', 'material', 'operationsData'];
            navButtons.forEach(nav => {
                const button = document.getElementById(`nav-${nav}`);
                if (nav === activeNav) {
                    button.classList.add('active');
                } else {
                    button.classList.remove('active');
                }
            });
        }
        
        // 运维大屏初始化函数
        let opsDashboardInitialized = false;
        let opsCharts = {};
        
        async function initOperationsDashboard() {
            if (opsDashboardInitialized) {
                // 如果已经初始化过，只刷新数据
                refreshOperationsDashboard();
                return;
            }
            
            // 从 API 获取真实的节点类型总数数据
            let entityCategories = {};
            try {
                const response = await fetch(`${API_BASE_URL}/graph/node-counts`);
                const data = await response.json();
                if (data.success && data.counts) {
                    entityCategories = data.counts;
                } else {
                    // 如果 API 调用失败，使用默认模拟数据
                    entityCategories = { "设备实体": 342, "故障现象": 187, "维修方案": 96, "零件物料": 223, "标准文档": 104 };
                }
            } catch (error) {
                console.error('加载节点类型数据失败:', error);
                entityCategories = { "设备实体": 342, "故障现象": 187, "维修方案": 96, "零件物料": 223, "标准文档": 104 };
            }
            
            const relationTypes = { "关联故障": 410, "解决方案引用": 289, "组成关系": 176, "关联设备": 303, "上下游依赖": 98 };
            const totalEntities = Object.values(entityCategories).reduce((a,b)=>a+b,0);
            const totalRelations = Object.values(relationTypes).reduce((a,b)=>a+b,0);
            
            const faultTop10 = [
                { name: "汽轮机振动超标", count: 78 }, { name: "锅炉管壁超温", count: 65 }, { name: "发电机转子接地", count: 54 },
                { name: "给水泵轴温过高", count: 47 }, { name: "磨煤机堵塞", count: 43 }, { name: "引风机轴承异响", count: 39 },
                { name: "凝汽器真空下降", count: 35 }, { name: "一次风机喘振", count: 31 }, { name: "空预器漏风", count: 28 },
                { name: "除氧器压力波动", count: 24 }
            ];
            
            const equipDistribution = { "锅炉": 38, "汽轮机": 32, "发电机": 22, "磨煤机": 18, "引风机": 12 };
            const faultCauses = { "设备老化": 34, "操作失误": 22, "维护不及时": 28, "设计缺陷": 10, "环境因素": 6 };
            const timelinessData = { "紧急维修": 2.5, "标准维修": 8.2, "计划性检修": 36.5, "预测性维护": 14.0 };
            
            const weeklyAccuracy = [82.5, 84.0, 86.2, 87.5, 89.1, 90.3, 91.8];
            const hotQuestions = [
                "如何排查汽轮机轴瓦温度异常？", "锅炉 MFT 动作条件有哪些？", "发电机碳刷打火处理方法", "磨煤机电流高的原因",
                "给水泵最小流量阀故障怎么处理？", "凝结水泵密封水压低的排查", "DEH 系统报警代码解读", "发电机氢气湿度标准",
                "锅炉吹灰器卡涩怎么办", "汽轮机转速波动原因"
            ];
            const hotQuestionsCount = [124, 98, 87, 76, 65, 54, 49, 42, 38, 35];
            const noAnswerQuestions = [
                "SCR 脱硝催化剂寿命如何预测？", "超临界机组锅炉启动曲线最优设定？", "发电机定子线棒流量偏差标准？",
                "汽轮机末级叶片水蚀修复工艺？", "智能巡检机器人故障自检逻辑？"
            ];
            const respTimeDist = { "0-200ms": 345, "200-500ms": 520, "500-1000ms": 280, "1000-2000ms": 95, ">2000ms": 28 };
            const avgResponseTime = 386;
            
            const totalDocs = 1247;
            const weeklyUpdateRate = 18;
            const equipmentCoverage = { "锅炉": 92, "汽轮机": 88, "发电机": 85, "磨煤机": 78, "引风机": 74, "给水泵": 81, "凝汽器": 70 };
            const knowledgeHotness = [
                { name: "汽轮机轴瓦检修规程", value: 286 }, { name: "锅炉四管防磨防爆手册", value: 254 },
                { name: "发电机励磁系统故障指南", value: 198 }, { name: "转动设备振动标准", value: 176 },
                { name: "DCS 控制系统维护要点", value: 143 }
            ];
            
            // 节点类型中英文映射
            const nodeTypeNameMap = {
                "EquipmentCategory": "设备种类",
                "Equipment": "设备",
                "Component": "部件",
                "Fault": "故障",
                "FaultPhenomenon": "故障现象",
                "FaultReason": "故障原因",
                "MaintenanceAction": "维修措施",
                "SafetyNotice": "安全注意事项",
                "KnowledgeSource": "知识来源"
            };
            
            // DOM 元素填充
            document.getElementById('totalEntities').innerText = totalEntities;
            document.getElementById('totalRelations').innerText = totalRelations;
            
            // 实体分类饼图
            opsCharts.entityChart = echarts.init(document.getElementById('entityCategoryChart'));
            opsCharts.entityChart.setOption({
                tooltip: { trigger: 'item' },
                legend: { orient: 'vertical', left: 'left', textStyle: { color: '#4682B4' } },
                series: [{
                    type: 'pie', radius: '55%',
                    data: Object.entries(entityCategories).map(([n,v])=>({name:nodeTypeNameMap[n] || n, value:v})),
                    itemStyle: { borderRadius: 8, borderColor: '#fff', borderWidth: 2 },
                    color: ['#1E90FF','#6495ED','#00BFFF','#87CEFA','#4682B4', '#20B2AA', '#5F9EA0', '#B0C4DE', '#87CEEB']
                }]
            });
            
            // 关系类型分布饼图
            opsCharts.relationChart = echarts.init(document.getElementById('relationTypeChart'));
            opsCharts.relationChart.setOption({
                tooltip: { trigger: 'item' },
                legend: { orient: 'vertical', left: 'left' },
                series: [{
                    type: 'pie', radius: '55%',
                    data: Object.entries(relationTypes).map(([n,v])=>({name:n, value:v})),
                    color: ['#48D1CC','#40E0D0','#00CED1','#5F9EA0','#008B8B']
                }]
            });
            
            // 高频故障 TOP10 列表渲染
            const faultListDiv = document.getElementById('faultTopList');
            faultListDiv.innerHTML = '';
            faultTop10.forEach((item, idx) => {
                const div = document.createElement('div');
                div.style.display = 'flex';
                div.style.justifyContent = 'space-between';
                div.style.padding = '6px 0';
                div.style.borderBottom = '1px solid #E0FFFF';
                div.innerHTML = `<span style="font-weight:600;color:#1E90FF;">${idx+1}</span> <span style="flex:1; margin:0 8px;">${item.name}</span> <span class="badge-blue">${item.count}次</span>`;
                faultListDiv.appendChild(div);
            });
            
            // 故障装备分布饼图
            opsCharts.equipChart = echarts.init(document.getElementById('equipmentPieChart'));
            opsCharts.equipChart.setOption({
                tooltip: { trigger: 'item' },
                legend: { orient: 'vertical', left: 'left' },
                series: [{
                    type: 'pie', radius: '50%',
                    data: Object.entries(equipDistribution).map(([n,v])=>({name:n, value:v})),
                    color: ['#1E90FF','#6495ED','#00BFFF','#87CEFA','#B0C4DE']
                }]
            });
            
            // 故障原因分析饼图
            opsCharts.causeChart = echarts.init(document.getElementById('faultCauseChart'));
            opsCharts.causeChart.setOption({
                tooltip: { trigger: 'item' },
                legend: { top: 'bottom' },
                series: [{
                    type: 'pie', radius: ['40%','65%'],
                    data: Object.entries(faultCauses).map(([n,v])=>({name:n, value:v})),
                    label: { show: true }
                }]
            });
            
            // 维修方案时效性统计
            opsCharts.timelinessChart = echarts.init(document.getElementById('timelinessChart'));
            opsCharts.timelinessChart.setOption({
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                xAxis: { type: 'value', name: '平均耗时 (小时)' },
                yAxis: { type: 'category', data: Object.keys(timelinessData), axisLabel: { fontWeight:500 } },
                series: [{
                    type: 'bar',
                    data: Object.values(timelinessData),
                    itemStyle: { color: '#1E90FF', borderRadius: [0, 8, 8, 0] },
                    label: { show: true, position: 'right' }
                }]
            });
            
            // 问答准确率趋势
            opsCharts.accuracyTrend = echarts.init(document.getElementById('accuracyTrendChart'));
            opsCharts.accuracyTrend.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: ['W-6','W-5','W-4','W-3','W-2','上周','本周'] },
                yAxis: { type: 'value', name: '准确率 (%)', min: 75 },
                series: [{
                    type: 'line',
                    data: weeklyAccuracy,
                    smooth: true,
                    lineStyle: { color: '#1E90FF', width: 3 },
                    areaStyle: { opacity: 0.1, color: '#87CEFA' },
                    symbol: 'circle',
                    symbolSize: 8
                }]
            });
            document.getElementById('accuracyRate').innerText = weeklyAccuracy[weeklyAccuracy.length-1] + '%';
            document.getElementById('avgRespTime').innerText = avgResponseTime;
            
            // 热门问题 TOP10 列表
            const hotList = document.getElementById('hotQuestionsList');
            hotList.innerHTML = '';
            for(let i=0; i<hotQuestions.length; i++) {
                const li = document.createElement('li');
                li.innerHTML = `<span class="trend-rank">${i+1}</span><span class="trend-question">${hotQuestions[i]}</span><span class="trend-count">${hotQuestionsCount[i]}次</span>`;
                hotList.appendChild(li);
            }
            
            // 无答案问题列表
            const noAnswerListDom = document.getElementById('noAnswerList');
            noAnswerListDom.innerHTML = '';
            noAnswerQuestions.forEach(q => {
                const li = document.createElement('li');
                li.innerHTML = `<i class="fas fa-exclamation-circle" style="color:#D97706; margin-right:8px;"></i><span class="noanswer-text">${q}</span>`;
                noAnswerListDom.appendChild(li);
            });
            document.getElementById('noAnswerCount').innerText = noAnswerQuestions.length;
            
            // 响应时间分布柱状图
            opsCharts.respTimeChart = echarts.init(document.getElementById('responseTimeChart'));
            opsCharts.respTimeChart.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: Object.keys(respTimeDist), axisLabel: { rotate: 15 } },
                yAxis: { type: 'value', name: '请求次数' },
                series: [{
                    type: 'bar',
                    data: Object.values(respTimeDist),
                    itemStyle: { color: '#6495ED', borderRadius: [6,6,0,0] }
                }]
            });
            
            // 知识资产数据
            document.getElementById('docTotal').innerText = totalDocs;
            document.getElementById('updateFreq').innerText = weeklyUpdateRate + ' 次/周';
            
            // 各装备知识覆盖率
            opsCharts.coverageChart = echarts.init(document.getElementById('coverageChart'));
            const covNames = Object.keys(equipmentCoverage);
            const covValues = Object.values(equipmentCoverage);
            opsCharts.coverageChart.setOption({
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                grid: { containLabel: true, left: '10%' },
                xAxis: { type: 'value', name: '覆盖率 (%)', max: 100 },
                yAxis: { type: 'category', data: covNames, axisLabel: { fontWeight: 500 } },
                series: [{
                    type: 'bar',
                    data: covValues,
                    itemStyle: { color: '#40E0D0', borderRadius: [0, 6, 6, 0] },
                    label: { show: true, position: 'right' }
                }]
            });
            
            // 知识引用热度柱状图
            opsCharts.hotKnowChart = echarts.init(document.getElementById('hotKnowledgeChart'));
            opsCharts.hotKnowChart.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: knowledgeHotness.map(k => k.name), axisLabel: { rotate: 20, interval: 0 } },
                yAxis: { type: 'value', name: '引用次数' },
                series: [{
                    type: 'bar',
                    data: knowledgeHotness.map(k => k.value),
                    itemStyle: { color: '#00BFFF', borderRadius: [6,6,0,0] }
                }]
            });
            
            // 响应式处理
            window.addEventListener('resize', () => {
                Object.values(opsCharts).forEach(ch => ch && ch.resize());
            });
            
            opsDashboardInitialized = true;
            console.log("运维大屏已初始化");
        }
        
        // 刷新运维大屏数据
        function refreshOperationsDashboard() {
            // 重新调整所有图表大小
            Object.values(opsCharts).forEach(ch => ch && ch.resize());
            console.log("运维大屏数据已刷新");
        }
    </script>

</body>
</html>