<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>船舶故障维修RAG系统</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <!-- Markdown渲染库 -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <!-- 代码高亮库 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css">
    <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/highlight.min.js"></script>
    <!-- 知识图谱可视化库 -->
    <script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.0/dist/vis-network.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/vis-network@9.1.0/dist/vis-network.min.css" rel="stylesheet">
    <!-- 图表库 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
    <!-- ECharts 可视化库 (运维大屏) -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
    <!-- Font Awesome 6.0 (运维大屏图标) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3b82f6',
                        secondary: '#64748b',
                        dark: '#1e293b',
                        light: '#f8fafc'
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .content-auto {
                content-visibility: auto;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
        }
        
        /* Markdown样式 */
        .prose {
            line-height: 1.6;
        }
        .prose h1, .prose h2, .prose h3, .prose h4 {
            font-weight: 600;
            margin-top: 1em;
            margin-bottom: 0.5em;
        }
        .prose h1 { font-size: 1.5em; }
        .prose h2 { font-size: 1.3em; }
        .prose h3 { font-size: 1.1em; }
        .prose p { margin: 0.5em 0; }
        .prose ul, .prose ol {
            margin: 0.5em 0;
            padding-left: 1.5em;
        }
        .prose li { margin: 0.25em 0; }
        .prose code {
            background-color: #f3f4f6;
            padding: 0.2em 0.4em;
            border-radius: 3px;
            font-size: 0.9em;
        }
        .prose pre {
            background-color: #f6f8fa;
            padding: 1em;
            border-radius: 6px;
            overflow-x: auto;
            margin: 0.5em 0;
        }
        .prose pre code {
            background-color: transparent;
            padding: 0;
        }
        .prose blockquote {
            border-left: 4px solid #d1d5db;
            padding-left: 1em;
            margin: 0.5em 0;
            color: #6b7280;
        }
        .prose table {
            border-collapse: collapse;
            width: 100%;
            margin: 0.5em 0;
        }
        .prose th, .prose td {
            border: 1px solid #d1d5db;
            padding: 0.5em;
        }
        .prose th {
            background-color: #f9fafb;
        }
        .prose a {
            color: #3b82f6;
            text-decoration: underline;
        }
        .prose strong {
            font-weight: 600;
        }
        .prose em {
            font-style: italic;
        }
        
        /* 加载动画 */
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .animate-spin {
            animation: spin 1s linear infinite;
        }
        
        .search-mode-label {
            transition: all 0.2s ease;
        }
        
        .search-mode-label:has(input:checked) {
            background-color: #3b82f6;
            border-color: #3b82f6;
            color: white;
        }
        
        .search-mode-label:has(input:checked):hover {
            background-color: #2563eb;
        }
        
        /* 导出菜单样式 */
        #export-menu {
            transition: opacity 0.2s ease, visibility 0.2s ease;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            min-width: 100px;
        }
        
        #export-menu-container:hover #export-menu {
            opacity: 1;
            visibility: visible;
        }
        
        #export-menu > div {
            padding: 8px 12px;
            font-size: 12px;
            line-height: 1.5;
        }
    </style>

    <link rel="stylesheet" type="text/css" href="index.css">
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
<div class="app-layout">
    <!-- 左侧导航栏 -->
    <div class="nav-sidebar">
        <!-- 头部区域 -->
        <div class="sidebar-header">
            <div class="system-title">
                <i class="fa fa-anchor"></i>
                <span>船舶故障维修RAG系统</span>
            </div>
            <div class="status-bar">
                <div class="connection-badge">
                    <span id="connection-status" class="status-dot"></span>
                    <span class="status-text" id="connection-text">连接中</span>
                </div>
                <div class="conv-count">
                    <span id="conversation-count">0</span> 个对话
                </div>
            </div>
        </div>

        <div class="nav-menu">
            <button id="nav-chat" class="nav-item active">
                <i class="fa fa-comments-o"></i>
                <span>对话</span>
            </button>
            <button id="nav-visualize" class="nav-item">
                <i class="fa fa-sitemap"></i>
                <span>知识图谱</span>
            </button>
            <button id="nav-import" class="nav-item">
                <i class="fa fa-upload"></i>
                <span>导入对话</span>
            </button>
            <button id="nav-material" class="nav-item">
                <i class="fa fa-file-text-o"></i>
                <span>资料导入</span>
            </button>
            <button id="nav-operationsData" class="nav-item">
                <i class="fa fa-server"></i>
                <span>系统运维</span>
            </button>
        </div>

        <!-- 新建对话按钮 -->
        <div class="new-conv-wrapper">
            <button id="new-conversation-btn" class="btn-new-conv">
                <i class="fa fa-plus"></i>
                <span>新建对话</span>
            </button>
        </div>

        <!-- 对话列表 -->
        <div id="conversation-list" class="conversation-list">
            <div class="empty-list">
                <i class="fa fa-commenting-o"></i>
                <p>暂无对话记录<br>点击「新建对话」开始</p>
            </div>
        </div>
    </div>
        
        <!-- 右侧内容区域 -->
        <div class="flex-1 flex flex-col bg-gray-50">
            <!-- 内容头部 -->
            <div class="right-header">
                <h2 id="content-title" style="font-size: 1.125rem; font-weight: 600; color: #1E90FF;">选择一个对话</h2>
                <div class="flex space-x-2">
                    <div id="export-menu-container" class="relative hidden">
                        <button id="export-conversation" class="text-secondary hover:text-primary transition-colors p-2 rounded-full">
                            <i class="fa fa-download"></i>
                        </button>
                        <div id="export-menu" class="absolute right-full top-0 mr-2 bg-white rounded-lg border border-gray-200 shadow-lg py-1">
                            <div id="export-word" class="px-3 text-gray-700 hover:bg-blue-50 cursor-pointer">
                                导出 Word
                            </div>
                            <div id="export-json" class="px-3 text-gray-700 hover:bg-blue-50 cursor-pointer">
                                导出 JSON
                            </div>
                            <div id="export-md" class="px-3 text-gray-700 hover:bg-blue-50 cursor-pointer">
                                导出 MD
                            </div>
                        </div>
                    </div>
                    <button id="delete-conversation" class="text-red-500 hover:text-red-600 transition-colors p-2 rounded-full hidden">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </div>
            
            <!-- 对话消息 -->
            <div id="chat-content" class="flex-1 overflow-y-auto p-4 space-y-4">
                <!-- 消息将通过JavaScript动态添加 -->
                <div class="flex justify-center items-center h-full text-gray-400">
                    <div class="text-center">
                        <i class="fa fa-comments-o text-4xl mb-2"></i>
                        <p>选择或创建一个对话开始</p>
                    </div>
                </div>
            </div>
            
            <!-- 导入对话内容 -->
            <div id="import-content">
        <div class="max-w-2xl mx-auto">
            <h3 class="import-title">导入对话</h3>
            <div class="import-card">
                <!-- 文件上传 -->
                <div class="form-group">
                    <label class="form-label">上传对话文件</label>
                    <input
                        type="file"
                        id="import-file"
                        accept=".json"
                        class="file-input"
                    >
                </div>

                <!-- 对话标题输入 -->
                <div class="form-group">
                    <label class="form-label">对话标题</label>
                    <input
                        type="text"
                        id="import-title"
                        class="text-input"
                        placeholder="输入对话标题"
                    >
                </div>

                <!-- 按钮组 -->
                <div class="button-group">
                    <button id="cancel-import" class="btn-cancel-import">
                        取消
                    </button>
                    <button id="confirm-import" class="btn-confirm-import">
                        导入
                    </button>
                </div>

                <!-- 提示信息区域 -->
                <div id="import-message" class="hidden"></div>
            </div>
        </div>
    </div>
            
            <!-- 资料导入内容 -->
    <div id="material-content">
        <div class="max-w-4xl mx-auto">
            <h3 class="material-title">资料导入</h3>
            <div class="material-card">
                <!-- 案例文本输入区 -->
                <div>
                    <label class="form-label">案例文本</label>
                    <textarea
                        id="material-text"
                        class="material-textarea"
                        rows="12"
                        placeholder="请输入案例文本，包括船舶装备、装备零部件、故障、故障现象、故障原因、维修步骤、注意事项等信息..."
                    ></textarea>
                </div>

                <!-- 按钮组 -->
                <div class="button-group">
                    <button id="cancel-material" class="btn-cancel-material">
                        取消
                    </button>
                    <button id="preview-material" class="btn-preview-material">
                        预览
                    </button>
                    <button id="confirm-material" class="btn-confirm-material">
                        导入资料
                    </button>
                </div>

                <!-- 预览区域 -->
                <div id="material-preview" class="info-container hidden">
                    <div class="info-box">
                        <div class="info-title"> 预览结果</div>
                        <div id="material-preview-content" class="info-content">
                            <!-- 预览结果将通过JavaScript动态添加 -->
                        </div>
                    </div>
                </div>

                <!-- 导入结果区域 -->
                <div id="material-result" class="info-container hidden">
                    <div class="info-box">
                        <div class="info-title">导入结果</div>
                        <div id="material-result-content" class="info-content">
                            <!-- 结果将通过JavaScript动态添加 -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
            
            <!-- 知识图谱可视化内容 -->
            <div id="visualize-content" class="flex-1 overflow-hidden hidden">
                <div class="app-container">
    <!-- 左侧美化面板 浅蓝基调 -->
    <div class="query-panel">
        <div class="panel-content">
            <div class="panel-title">
                <span>知识图谱探索</span>
            </div>

            <!-- 查询区 -->
            <div class="form-row">
  <div>
    <label class="label-light">关键词</label>
  </div>
  <div>
    <input type="text" id="graph-query" class="input-modern" placeholder="例如: 电机故障 / 安全阀 ...">
  </div>
</div>

<div class="form-row">
  <div>
    <label class="label-light">实体类型</label>
  </div>
  <div class="custom-select-wrapper">
    <!-- 自定义触发器，保持 select-modern 样式风格 -->
    <div class="select-modern custom-select-trigger">
      <span>所有类型</span>
      <i class="arrow-icon"></i>
    </div>
    <!-- 自定义选项面板 -->
    <div class="custom-select-options">
      <div data-value="all" class="option-item selected">所有类型</div>
      <div data-value="Equipment" class="option-item">设备</div>
      <div data-value="Component" class="option-item">部件</div>
      <div data-value="Fault" class="option-item">故障</div>
      <div data-value="FaultReason" class="option-item">故障原因</div>
      <div data-value="MaintenanceAction" class="option-item">维修措施</div>
      <div data-value="SafetyNotice" class="option-item">安全注意事项</div>
      <div data-value="KnowledgeSource" class="option-item">知识来源</div>
    </div>
    <!-- 隐藏原生select，用于表单提交 -->
    <select id="entity-type" class="hidden-select" >
      <option value="all">所有类型</option>
      <option value="Equipment">设备</option>
      <option value="Component">部件</option>
      <option value="Fault">故障</option>
      <option value="FaultReason">故障原因</option>
      <option value="MaintenanceAction">维修措施</option>
      <option value="SafetyNotice">安全注意事项</option>
      <option value="KnowledgeSource">知识来源</option>
    </select>
  </div>
</div>

            <button id="execute-query" class="btn-primary">
                执行查询
            </button>

            <!-- 节点限制滑块 -->
            <div style="margin: 1.5rem 0 0.5rem;">
                <div class="label-light">节点数量限制 <span class="limit-value" id="node-limit-value">200</span></div>
                <input type="range" id="node-limit" min="50" max="350" value="200" class="slider-custom">
                <div class="flex justify-between text-xs" style="display: flex; justify-content: space-between; font-size: 0.7rem; color:#6f9cbd; margin-top: 4px;">
                    <span>50</span>
                    <span>推荐 ≤ 250</span>
                    <span>350</span>
                </div>
                <p class="text-xs" style="text-align: center; font-size: 0.7rem; color:#F39C12; margin-top: 8px; background:#FFF7E8; border-radius: 30px; padding: 4px 10px;">
                    超过350节点可能影响性能，请按需调节
                </p>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 12px;">
                <button id="show-all" class="btn-secondary">
                    显示全部
                </button>
                <button id="load-more" class="btn-secondary hidden">
                    加载更多
                </button>
            </div>

            <!-- 统计模块 节点类型总数 & 当前显示统计 & 饼图 -->
            <div class="stats-card">
                <div class="stats-header">
                    <h4>节点类型总数</h4>
                    <button id="refresh-counts" class="refresh-btn"><i class="fas fa-sync-alt"></i> 刷新</button>
                </div>
                <div id="node-type-counts" class="stat-list">
                    <!-- 动态内容展示全量节点统计 -->
                    <div style="text-align:center; color:#9cb9d0;">加载统计中...</div>
                </div>
                <hr>
                <div class="stats-header">
                    <h4>当前图谱显示统计</h4>
                </div>
                <div id="graph-stats" class="graph-stats-block">
                    <!-- 统计信息将通过JavaScript动态添加 -->
                </div>
                <div class="stats-header">
                    <h4>节点类型分布</h4>
                </div>
                <div class="chart-wrapper">
                    <canvas id="nodeTypeChart" width="300" style="width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 右侧图谱展示 -->
                    <div class="graph-area">
        <div class="graph-card">
            <div id="graph-container" style="width:100%; height:100%;">
                <div class="graph-placeholder">
                   <p>点击「显示全部」或执行查询，展示知识图谱</p>
                </div>
            </div>
        </div>
    </div>
</div>

            </div>
            <!-- 系统运维内容 -->
            <div id="operationsData-content" class="flex-1 hidden" style="overflow: hidden;">
                <div class="dashboard" style="overflow-y: auto; height: 100%; padding-right: 10px;">
                    <!-- 三栏布局：左侧 + 中央 + 右侧 -->
                    <div class="dashboard-grid">
                        <!-- 左侧栏：知识图谱概览 + 知识资产概览 -->
                        <div class="dashboard-left">
                            <!-- 1. 知识图谱概览卡片 -->
                            <div class="card full-width mb-4">
                                <div class="card-header">
                                    <i class="fas fa-project-diagram"></i>
                                    <h2>知识图谱概览</h2>
                                </div>
                                <div class="card-body">
                                    <div class="stats-row">
                                        <div class="stat-item">
                                            <div class="stat-number" id="totalEntities">--</div>
                                            <div class="stat-label">实体总数</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-number" id="totalRelations">--</div>
                                            <div class="stat-label">关系总数</div>
                                        </div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-tags"></i> 实体分类统计</div>
                                        <div id="entityCategoryChart" class="chart-container" style="height: 220px;"></div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-share-alt"></i> 关系类型分布</div>
                                        <div id="relationTypeChart" class="chart-container" style="height: 220px;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- 4. 知识资产概览 -->
                            <div class="card full-width">
                                <div class="card-header">
                                    <i class="fas fa-database"></i>
                                    <h2>知识资产概览</h2>
                                </div>
                                <div class="card-body">
                                    <div class="stats-row">
                                        <div class="stat-item">
                                            <div class="stat-number" id="docTotal">--</div>
                                            <div class="stat-label">知识文档总数</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-number" id="updateFreq">--</div>
                                            <div class="stat-label">近 30 天更新频率 (次/周)</div>
                                        </div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-microchip"></i> 各装备知识覆盖率</div>
                                        <div id="coverageChart" class="chart-container" style="height: 230px;"></div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-chart-simple"></i> 知识引用热度 TOP5</div>
                                        <div id="hotKnowledgeChart" class="chart-container" style="height: 220px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 中央主体：问答系统监控 -->
                        <div class="dashboard-center">
                            <!-- 3. 问答系统监控 -->
                            <div class="card full-width">
                                <div class="card-header">
                                    <i class="fas fa-comments"></i>
                                    <h2>问答系统监控</h2>
                                </div>
                                <div class="card-body">
                                    <div class="stats-row">
                                        <div class="stat-item">
                                            <div class="stat-number" id="accuracyRate">--</div>
                                            <div class="stat-label">当前问答准确率</div>
                                        </div>
                                        <div class="stat-item">
                                            <div class="stat-number" id="avgRespTime">--</div>
                                            <div class="stat-label">平均响应时间 (ms)</div>
                                        </div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-chart-line"></i> 问答准确率趋势 (近 7 周)</div>
                                        <div id="accuracyTrendChart" class="chart-container" style="height: 210px;"></div>
                                    </div>
                                    <div style="display: flex; flex-wrap: wrap; gap: 24px; margin-top: 16px;">
                                        <div style="flex: 1; min-width: 200px;">
                                            <div class="sub-title"><i class="fas fa-fire"></i> 热门问题 TOP10</div>
                                            <ul id="hotQuestionsList" class="trend-list"></ul>
                                        </div>
                                        <div style="flex: 1; min-width: 200px;">
                                            <div class="sub-title"><i class="fas fa-question-circle"></i> 无答案问题统计（待补充）</div>
                                            <ul id="noAnswerList" class="noanswer-list"></ul>
                                            <div class="badge-blue" style="margin-top: 12px; display: inline-block;">共 <span id="noAnswerCount">0</span> 条待补充知识</div>
                                        </div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-tachometer-alt"></i> 响应时间分布 (毫秒区间)</div>
                                        <div id="responseTimeChart" class="chart-container" style="height: 200px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 右侧栏：故障分析仪表盘 -->
                        <div class="dashboard-right">
                            <!-- 2. 故障分析仪表盘 -->
                            <div class="card full-width">
                                <div class="card-header">
                                    <i class="fas fa-chart-line"></i>
                                    <h2>故障分析仪表盘</h2>
                                </div>
                                <div class="card-body">
                                    <div style="display: flex; flex-wrap: wrap; gap: 20px;">
                                        <div style="flex: 1.2; min-width: 200px;">
                                            <div class="sub-title"><i class="fas fa-list-ol"></i> 高频故障 TOP10</div>
                                            <div id="faultTopList" style="max-height: 260px; overflow-y: auto; padding-right: 6px;">
                                                <!-- 动态列表 -->
                                            </div>
                                        </div>
                                        <div style="flex: 1; min-width: 150px;">
                                            <div class="sub-title"><i class="fas fa-chart-pie"></i> 故障装备分布（四机一炉占比）</div>
                                            <div id="equipmentPieChart" class="small-chart" style="height: 210px;"></div>
                                        </div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-chart-bar"></i> 故障原因分析（鱼骨图等效饼图）</div>
                                        <div id="faultCauseChart" class="chart-container" style="height: 220px;"></div>
                                    </div>
                                    <div class="sub-section">
                                        <div class="sub-title"><i class="fas fa-clock"></i> 维修方案时效性统计（平均处理时长/时效等级）</div>
                                        <div id="timelinessChart" class="chart-container" style="height: 220px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 输入区域 -->
            <div id="chat-input-area">
            <div class="search-mode-section">
<!--                <label class="section-label">搜索方式</label>-->
                <div class="search-mode-group">
                    <label class="search-mode-label" data-mode="intelligent">
                        <input type="radio" name="search-mode" value="intelligent" checked>
                        <span>智能路由</span>
                    </label>
                    <label class="search-mode-label" data-mode="traditional">
                        <input type="radio" name="search-mode" value="traditional">
                        <span>传统双搜索</span>
                    </label>
                    <label class="search-mode-label" data-mode="graph">
                        <input type="radio" name="search-mode" value="graph">
                        <span>图搜索</span>
                    </label>
                    <label class="search-mode-label" data-mode="combined">
                        <input type="radio" name="search-mode" value="combined">
                        <span>组合搜索</span>
                    </label>
                </div>
            </div>
            <form id="message-form" class="message-form">
                <input
                    type="text"
                    id="message-input"
                    placeholder="输入您的问题..."
                    autocomplete="off"
                >
                <button type="submit" class="send-btn">
                    发送
                </button>
            </form>
        </div>
    
    <!-- 新对话模态框 -->
    <div id="new-conversation-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden modal-overlay">
        <div class="modal-container">
            <!-- 头部区域 -->
            <div class="modal-header">
                <h3 class="modal-title">创建新对话</h3>
            </div>

            <!-- 主体区域: 输入框及标签 -->
            <div class="modal-body">
                <label class="input-label" for="conversation-title-input"></label>
                <input
                    type="text"
                    id="conversation-title-input"
                    class="blue-input"
                    placeholder="请输入新对话标题"
                    autocomplete="off"
                >
            </div>

            <!-- 按钮组 -->
            <div class="modal-actions">
                <button id="cancel-new-conversation" class="btn-cancel">取消</button>
                <button id="confirm-new-conversation" class="btn-create">创建</button>
            </div>
        </div>
    </div>
        </div>
</div>
    <script>
    // 自定义下拉框功能
    function initCustomSelects() {
        const customSelectWrappers = document.querySelectorAll('.custom-select-wrapper');

        customSelectWrappers.forEach(wrapper => {
            const trigger = wrapper.querySelector('.custom-select-trigger');
            const optionsPanel = wrapper.querySelector('.custom-select-options');
            const hiddenSelect = wrapper.querySelector('.hidden-select');
            const triggerSpan = trigger.querySelector('span');

            // 点击触发器
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();

                // 关闭其他下拉框
                document.querySelectorAll('.custom-select-options.show').forEach(panel => {
                    if (panel !== optionsPanel) {
                        panel.classList.remove('show');
                        panel.previousElementSibling?.classList.remove('open');
                    }
                });

                // 切换当前下拉框
                optionsPanel.classList.toggle('show');
                trigger.classList.toggle('open');
            });

            // 选项点击
            wrapper.querySelectorAll('.option-item').forEach(option => {
                option.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const value = this.dataset.value;
                    const text = this.textContent;

                    // 更新显示
                    triggerSpan.textContent = text;

                    // 更新隐藏select
                    if (hiddenSelect) {
                        hiddenSelect.value = value;
                        hiddenSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    }

                    // 更新选中样式
                    wrapper.querySelectorAll('.option-item').forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');

                    // 关闭下拉框
                    optionsPanel.classList.remove('show');
                    trigger.classList.remove('open');
                });
            });
        });
    }

    // 点击其他地方关闭
    document.addEventListener('click', function() {
        document.querySelectorAll('.custom-select-options.show').forEach(panel => {
            panel.classList.remove('show');
            panel.previousElementSibling?.classList.remove('open');
        });
    });

    // 初始化
    document.addEventListener('DOMContentLoaded', function() {
        initCustomSelects();

        // 设置默认值
        document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
            const hiddenSelect = wrapper.querySelector('.hidden-select');
            const triggerSpan = wrapper.querySelector('.custom-select-trigger span');
            const options = wrapper.querySelectorAll('.option-item');

            if (hiddenSelect && hiddenSelect.value) {
                const selectedOption = Array.from(options).find(opt => opt.dataset.value === hiddenSelect.value);
                if (selectedOption) {
                    triggerSpan.textContent = selectedOption.textContent;
                    selectedOption.classList.add('selected');
                }
            }
        });
    });
</script>
    <script>
        // 全局变量
        let currentConversationId = null;
        let network = null;
        let currentGraph = null;
        
        // API基础URL
        const API_BASE_URL = 'http://localhost:8002/api';
        
        // 初始化
        document.addEventListener('DOMContentLoaded', function() {
            loadConversations();
            updateConversationCount();
            setupEventListeners();
        });
        
        // 更新连接状态
        function updateConnectionStatus(connected) {
            const statusElement = document.getElementById('connection-status');
            const textElement = document.getElementById('connection-text');
            if (connected) {
                statusElement.className = 'w-2 h-2 rounded-full bg-green-500';
                statusElement.title = '已连接';
                if (textElement) textElement.textContent = '已连接';
            } else {
                statusElement.className = 'w-2 h-2 rounded-full bg-red-500';
                statusElement.title = '未连接';
                if (textElement) textElement.textContent = '未连接';
            }
        }
        
        // 更新对话数量
        async function updateConversationCount() {
            try {
                const response = await fetch(`${API_BASE_URL}/system/stats`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                document.getElementById('conversation-count').textContent = `对话数量: ${data.conversation_count}`;
                updateConnectionStatus(true);
            } catch (error) {
                console.error('获取对话数量失败:', error);
                document.getElementById('conversation-count').textContent = '对话数量: -';
                updateConnectionStatus(false);
                showError('无法连接到后端服务，请确保服务已启动 (端口: 8002)');
            }
        }
        
        // 显示错误信息
        function showError(message) {
            const chatContent = document.getElementById('chat-content');
            chatContent.innerHTML = `
                <div class="flex justify-center items-center h-full text-red-500">
                    <div class="text-center p-4 bg-red-50 rounded-lg border border-red-200">
                        <i class="fa fa-exclamation-triangle text-3xl mb-2"></i>
                        <p>${message}</p>
                        <p class="text-sm mt-2">请检查:</p>
                        <ul class="text-sm text-left mt-1">
                            <li>1. 后端服务是否已启动</li>
                            <li>2. 访问的端口是否正确 (8002)</li>
                            <li>3. 网络连接是否正常</li>
                        </ul>
                    </div>
                </div>
            `;
        }
        
        // 加载对话列表
        async function loadConversations() {
            try {
                const response = await fetch(`${API_BASE_URL}/conversations`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                
                const conversationList = document.getElementById('conversation-list');
                conversationList.innerHTML = '';
                
                if (!data.conversations || data.conversations.length === 0) {
                    conversationList.innerHTML = `
                        <div class="text-center text-gray-400 p-4">
                            <i class="fa fa-comment-o text-2xl mb-2"></i>
                            <p>暂无对话</p>
                            <p class="text-xs">点击"新对话"开始</p>
                        </div>
                    `;
                    return;
                }
                
                // 按更新时间排序，最新的在前面
                data.conversations.sort((a, b) => new Date(b.updated_at) - new Date(a.updated_at));
                
                data.conversations.forEach(conversation => {
                    const conversationItem = document.createElement('div');
                    conversationItem.className = `p-3 rounded-lg cursor-pointer hover:bg-gray-100 transition-colors ${currentConversationId === conversation.id ? 'bg-blue-50 border-l-4 border-primary' : ''}`;
                    conversationItem.dataset.id = conversation.id;
                    
                    const time = new Date(conversation.updated_at).toLocaleString('zh-CN', {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    conversationItem.innerHTML = `
                        <div class="flex justify-between items-center mb-1">
                            <h3 class="font-medium text-sm truncate flex-1 min-w-0">${conversation.title}</h3>
                            <span class="text-xs text-gray-500 ml-2 whitespace-nowrap">${time}</span>
                        </div>
                        <p class="text-xs text-gray-500 truncate">
                            ${conversation.messages.length > 0 ? conversation.messages[conversation.messages.length - 1].content : '无消息'}
                        </p>
                    `;
                    
                    conversationItem.addEventListener('click', () => {
                        selectConversation(conversation.id);
                    });
                    
                    conversationList.appendChild(conversationItem);
                });
            } catch (error) {
                console.error('加载对话失败:', error);
            }
        }
        
        // 选择对话
        async function selectConversation(conversationId) {
            try {
                const response = await fetch(`${API_BASE_URL}/conversations/${conversationId}`);
                const conversation = await response.json();
                
                currentConversationId = conversationId;
                
                // 更新对话标题
                document.getElementById('content-title').textContent = conversation.title;
                
                // 显示聊天内容
                showChatContent();
                
                // 更新消息容器
                const chatContent = document.getElementById('chat-content');
                chatContent.innerHTML = '';
                
                if (conversation.messages.length === 0) {
                    chatContent.innerHTML = `
                        <div class="flex justify-center items-center h-full text-gray-400">
                            <p>开始您的第一个问题</p>
                        </div>
                    `;
                } else {
                    conversation.messages.forEach(message => {
                        // 助手消息使用Markdown渲染
                        const isMarkdown = message.role === 'assistant';
                        addMessageToContainer(message.role, message.content, message.timestamp, isMarkdown);
                    });
                    
                    // 滚动到底部
                    chatContent.scrollTop = chatContent.scrollHeight;
                }
                
                // 显示导出和删除按钮
                document.getElementById('export-menu-container').classList.remove('hidden');
                document.getElementById('delete-conversation').classList.remove('hidden');
                
                // 更新对话列表的选中状态
                loadConversations();
            } catch (error) {
                console.error('加载对话失败:', error);
            }
        }
        
        // 添加消息到容器
        function addMessageToContainer(role, content, timestamp, isMarkdown = false) {
            const chatContent = document.getElementById('chat-content');
            const messageDiv = document.createElement('div');
            
            const time = new Date(timestamp).toLocaleString('zh-CN', {
                hour: '2-digit',
                minute: '2-digit'
            });
            
            if (role === 'user') {
                messageDiv.className = 'flex justify-end';
                messageDiv.innerHTML = `
                    <div class="quest-content">
                      <div class="quest-text-wrapper">
                      <p class="quest-text">${content}</p>
                      </div>
                        <div class="quest-time">${time}</div>
                    </div>
                `;
            } else {
                messageDiv.className = 'flex';
                const displayContent = isMarkdown ? marked.parse(content) : content;
                messageDiv.innerHTML = `
                    <div class="max-w-[80%] bg-white rounded-lg p-4 shadow-sm border border-gray-100">
                        <div class="text-sm prose prose-sm max-w-none">${displayContent}</div>
                        <p class="text-xs text-gray-500 mt-1 text-right">${time}</p>
                    </div>
                `;
                // 高亮代码块
                messageDiv.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });
            }
            
            chatContent.appendChild(messageDiv);
            return messageDiv;
        }
        
        // 添加正在回答的加载样式
        function addLoadingMessage() {
            const chatContent = document.getElementById('chat-content');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'flex';
            messageDiv.id = 'loading-message';
            messageDiv.innerHTML = `
                <div class="max-w-[80%] bg-white rounded-lg p-4 shadow-sm border border-gray-100">
                    <div class="flex items-center space-x-2">
                        <div class="flex space-x-1">
                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></div>
                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></div>
                        </div>
                    </div>
                </div>
            `;
            chatContent.appendChild(messageDiv);
            chatContent.scrollTop = chatContent.scrollHeight;
            return messageDiv;
        }

        // 移除正在回答的加载样式
        function removeLoadingMessage() {
            const loadingMessage = document.getElementById('loading-message');
            if (loadingMessage) {
                loadingMessage.remove();
            }
        }
        
        // 发送消息
        async function sendMessage() {
            const messageInput = document.getElementById('message-input');
            const message = messageInput.value.trim();
            
            if (!message) return;
            
            const searchMode = document.querySelector('input[name="search-mode"]:checked').value;
            
            messageInput.value = '';
            
            const tempTimestamp = new Date().toISOString();
            addMessageToContainer('user', message, tempTimestamp);
            
            // 添加正在回答的加载样式
            addLoadingMessage();
            
            const chatContent = document.getElementById('chat-content');
            chatContent.scrollTop = chatContent.scrollHeight;
            
            let isFirstChunk = true;
            let assistantMessageDiv = null;
            let contentDiv = null;
            
            try {
                const response = await fetch(`${API_BASE_URL}/query/stream`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        conversation_id: currentConversationId,
                        message: message,
                        search_mode: searchMode
                    })
                });
                
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let fullContent = '';
                
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    
                    const chunk = decoder.decode(value);
                    const lines = chunk.split('\n');
                    
                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            const data = JSON.parse(line.slice(6));
                            
                            if (data.done) {
                                // 流式输出完成
                                currentConversationId = data.conversation_id;
                                // 更新对话列表和数量
                                loadConversations();
                                updateConversationCount();
                                // 更新内容标题
                                document.getElementById('content-title').textContent = '对话';
                                // 显示导出和删除按钮
                                document.getElementById('export-menu-container').classList.remove('hidden');
                                document.getElementById('delete-conversation').classList.remove('hidden');
                            } else if (data.content) {
                                // 收到第一个内容块时，移除加载样式并创建助手消息
                                if (isFirstChunk) {
                                    removeLoadingMessage();
                                    assistantMessageDiv = addMessageToContainer('assistant', '', tempTimestamp, false);
                                    contentDiv = assistantMessageDiv.querySelector('.prose');
                                    isFirstChunk = false;
                                }
                                
                                // 添加内容
                                fullContent += data.content;
                                // 实时渲染 Markdown
                                contentDiv.innerHTML = marked.parse(fullContent);
                                // 高亮代码块
                                assistantMessageDiv.querySelectorAll('pre code').forEach((block) => {
                                    hljs.highlightElement(block);
                                });
                                // 滚动到底部
                                chatContent.scrollTop = chatContent.scrollHeight;
                            }
                        }
                    }
                }
                
                // 如果流式输出完成但没有收到任何内容（异常情况），移除加载样式
                if (isFirstChunk) {
                    removeLoadingMessage();
                }
            } catch (error) {
                console.error('发送消息失败:', error);
                // 移除加载样式
                removeLoadingMessage();
                // 显示错误消息
                if (!assistantMessageDiv) {
                    assistantMessageDiv = addMessageToContainer('assistant', '', tempTimestamp, false);
                    contentDiv = assistantMessageDiv.querySelector('.prose');
                }
                contentDiv.innerHTML = marked.parse('抱歉，处理您的请求时出现错误。');
            }
        }
        
        // 导出对话为 JSON
        async function exportConversation() {
            if (!currentConversationId) return;
            
            try {
                const response = await fetch(`${API_BASE_URL}/export/${currentConversationId}`);
                const data = await response.json();
                
                if (data.success && data.url) {
                    // 创建下载链接
                    const link = document.createElement('a');
                    link.href = data.url;
                    link.download = `conversation_${currentConversationId}.json`;
                    link.click();
                }
            } catch (error) {
                console.error('导出对话失败:', error);
            }
        }

        // 导出对话为 Markdown
        async function exportConversationToMD() {
            if (!currentConversationId) return;

            try {
                const response = await fetch(`${API_BASE_URL}/export-md/${currentConversationId}`);
                const data = await response.json();

                if (data.success && data.url) {
                    const link = document.createElement('a');
                    link.href = data.url;
                    link.download = `conversation_${currentConversationId}.md`;
                    link.click();
                }
            } catch (error) {
                console.error('导出 MD 失败:', error);
                alert('导出 MD 失败：' + (error.message || '未知错误'));
            }
        }
        
        // 导出对话为 Word
        async function exportConversationToWord() {
            if (!currentConversationId) return;
            
            try {
                const response = await fetch(`${API_BASE_URL}/conversations/${currentConversationId}`);
                const conversation = await response.json();
                
                // 创建 Word 文档内容（使用 HTML 格式）
                let wordContent = `
                    <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
                    <head>
                        <meta charset='UTF-8'>
                        <style>
                            body { font-family: 'Microsoft YaHei', Arial, sans-serif; }
                            h1 { color: #3b82f6; border-bottom: 2px solid #3b82f6; padding-bottom: 10px; }
                            .message { margin: 15px 0; padding: 10px; border-radius: 5px; }
                            .user { background-color: #e3f2fd; border-left: 4px solid #3b82f6; }
                            .assistant { background-color: #f5f5f5; border-left: 4px solid #10b981; }
                            .timestamp { color: #666; font-size: 12px; margin-top: 5px; }
                            table { width: 100%; border-collapse: collapse; margin: 10px 0; }
                            th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
                            th { background-color: #f2f2f2; }
                        </style>
                    </head>
                    <body>
                        <h1>${conversation.title}</h1>
                        <p><strong>导出时间:</strong> ${new Date().toLocaleString('zh-CN')}</p>
                        <hr/>
                `;
                
                conversation.messages.forEach(message => {
                    const time = new Date(message.timestamp).toLocaleString('zh-CN', {
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                    
                    const roleText = message.role === 'user' ? '用户' : '助手';
                    const roleClass = message.role === 'user' ? 'user' : 'assistant';
                    
                    wordContent += `
                        <div class="message ${roleClass}">
                            <strong>${roleText}</strong>
                            <div>${message.content.replace(/\n/g, '<br>')}</div>
                            <div class="timestamp">${time}</div>
                        </div>
                    `;
                });
                
                wordContent += `
                    </body>
                    </html>
                `;
                
                // 创建 Blob 并下载
                const blob = new Blob(['\ufeff', wordContent], {
                    type: 'application/msword'
                });
                
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `${conversation.title}.doc`;
                link.click();
                
                URL.revokeObjectURL(link.href);
            } catch (error) {
                console.error('导出 Word 失败:', error);
                alert('导出 Word 失败：' + (error.message || '未知错误'));
            }
        }
        
        // 删除对话
        async function deleteConversation() {
            if (!currentConversationId) return;
            
            if (confirm('确定要删除这个对话吗？')) {
                try {
                    const response = await fetch(`${API_BASE_URL}/conversations/${currentConversationId}`, {
                        method: 'DELETE'
                    });
                    
                    const data = await response.json();
                    if (data.success) {
                        currentConversationId = null;
                        
                        // 重置界面
                        document.getElementById('content-title').textContent = '选择一个对话';
                        document.getElementById('chat-content').innerHTML = `
                            <div class="flex justify-center items-center h-full text-gray-400">
                                <div class="text-center">
                                    <i class="fa fa-comments-o text-4xl mb-2"></i>
                                    <p>选择或创建一个对话开始</p>
                                </div>
                            </div>
                        `;
                        
                        // 隐藏导出和删除按钮
                        document.getElementById('export-menu-container').classList.add('hidden');
                        document.getElementById('delete-conversation').classList.add('hidden');
                        
                        // 更新对话列表
                        loadConversations();
                        
                        // 更新对话数量
                        updateConversationCount();
                    }
                } catch (error) {
                    console.error('删除对话失败:', error);
                }
            }
        }
        
        // 预览资料
        async function previewMaterial() {
            const materialText = document.getElementById('material-text').value.trim();
            
            if (!materialText) {
                alert('请输入案例文本');
                return;
            }
            
            try {
                const formData = new FormData();
                formData.append('case_text', materialText);
                
                const response = await fetch(`${API_BASE_URL}/material/preview`, {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                // 显示预览结果
                const previewDiv = document.getElementById('material-preview');
                const previewContent = document.getElementById('material-preview-content');
                
                if (data.success) {
                    previewDiv.classList.remove('hidden');
                    
                    const parsedData = data.result?.parsed_data;
                    const statistics = data.result?.statistics;
                    
                    let previewHTML = `
                        <div class="text-blue-600 font-semibold mb-2">✓ 预览成功</div>
                        <div class="text-gray-700 space-y-3">
                            <div>
                                <h5 class="font-medium text-sm mb-1">LLM提取结果：</h5>
                                <div class="bg-white p-3 rounded border border-gray-200">
                                    <pre class="text-xs overflow-x-auto">${JSON.stringify(parsedData, null, 2)}</pre>
                                </div>
                            </div>
                            <div>
                                <h5 class="font-medium text-sm mb-1">编辑提取结果（JSON格式）：</h5>
                                <textarea id="parsed-data-input" class="w-full border border-gray-300 rounded-lg px-3 py-2 h-64 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">${JSON.stringify(parsedData, null, 2)}</textarea>
                                <p class="text-xs text-gray-500 mt-1">请确保修改后仍为有效的JSON格式</p>
                            </div>
                    `;
                    
                    if (statistics) {
                        previewHTML += `
                            <div>
                                <h5 class="font-medium text-sm mb-1">统计信息：</h5>
                                <ul class="text-xs space-y-1">
                                    <li>• 维修步骤数量：${statistics.maintenance_steps}</li>
                                    <li>• Cypher语句数量：${statistics.cypher_statements}</li>
                                    <li>• 关系键值对数量：${statistics.relation_key_values}</li>
                                </ul>
                            </div>
                        `;
                    }
                    
                    previewHTML += `
                            <div class="flex justify-end space-x-2 mt-4">
                                <button id="cancel-import-preview" class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-sm">
                                    取消
                                </button>
                                <button id="confirm-import-preview" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-600 transition-colors text-sm">
                                    确认导入
                                </button>
                            </div>
                        </div>
                    `;
                    
                    previewContent.innerHTML = previewHTML;
                    
                    // 添加确认导入按钮的事件监听器
                    document.getElementById('confirm-import-preview').addEventListener('click', function() {
                        confirmImportWithParsedData();
                    });
                    
                    // 添加取消按钮的事件监听器
                    document.getElementById('cancel-import-preview').addEventListener('click', function() {
                        previewDiv.classList.add('hidden');
                    });
                } else {
                    previewDiv.classList.remove('hidden');
                    previewContent.innerHTML = `
                        <div class="text-red-600 font-semibold mb-2">✗ 预览失败</div>
                        <div class="text-gray-700">
                            <p>${data.message || '未知错误'}</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('预览资料失败:', error);
                alert('预览资料失败: ' + (error.message || '未知错误'));
            }
        }
        
        // 确认导入（带修改的解析数据）
        async function confirmImportWithParsedData() {
            const parsedDataInput = document.getElementById('parsed-data-input');
            const parsedDataText = parsedDataInput.value.trim();
            
            try {
                // 验证JSON格式
                JSON.parse(parsedDataText);
            } catch (error) {
                alert('JSON格式错误，请检查修改后的内容');
                return;
            }
            
            try {
                const formData = new FormData();
                formData.append('parsed_data', parsedDataText);
                formData.append('case_text', document.getElementById('material-text').value.trim());
                
                const response = await fetch(`${API_BASE_URL}/material/import-with-parsed`, {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                // 显示导入结果
                const resultDiv = document.getElementById('material-result');
                const resultContent = document.getElementById('material-result-content');
                
                if (data.success) {
                    resultDiv.classList.remove('hidden');
                    resultContent.innerHTML = `
                        <div class="text-green-600 font-semibold mb-2">✓ 导入成功</div>
                        <div class="text-gray-700">
                            <p>案例已成功导入到Neo4j数据库</p>
                            ${data.result ? `<p>详细信息：${JSON.stringify(data.result, null, 2)}</p>` : ''}
                        </div>
                    `;
                    
                    // 清空输入框
                    document.getElementById('material-text').value = '';
                    // 隐藏预览结果
                    document.getElementById('material-preview').classList.add('hidden');
                } else {
                    resultDiv.classList.remove('hidden');
                    resultContent.innerHTML = `
                        <div class="text-red-600 font-semibold mb-2">✗ 导入失败</div>
                        <div class="text-gray-700">
                            <p>${data.message || '未知错误'}</p>
                            ${data.result ? `<p>详细信息：${JSON.stringify(data.result, null, 2)}</p>` : ''}
                        </div>
                    `;
                }
            } catch (error) {
                console.error('导入资料失败:', error);
                alert('导入资料失败: ' + (error.message || '未知错误'));
            }
        }

